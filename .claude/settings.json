{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run check)",
      "Bash(npm run test:e2e)",
      "Bash(npm --prefix shared test)",
      "Bash(npm --prefix shared run typecheck)",
      "Bash(npm --prefix teacher test)",
      "Bash(npm --prefix teacher run check)",
      "Bash(npx tsc --noEmit *)",
      "Bash(npx vitest run *)",
      "Bash(npx eslint *)",
      "Bash(corepack yarn test *)",
      "Bash(corepack yarn typecheck *)",
      "Bash(corepack yarn check *)",
      "Bash(scripts/devices.sh doctor *)",
      "Bash(scripts/devices.sh verify *)",
      "Bash(scripts/devices.sh crash *)",
      "Bash(adb devices *)"
    ],
    "deny": [
      "Bash(./gradlew clean *)",
      "Bash(gradlew clean *)",
      "Edit(/teacher/android/**)",
      "Edit(/teacher/ios/**)",
      "Edit(/tv/apps/expo-tv/android/**)",
      "Edit(/tv/apps/expo-tv/ios/**)"
    ]
  },
  "extraKnownMarketplaces": {
    "logo-design-skill": {
      "source": {
        "source": "github",
        "repo": "kaankiziltug/logo-design-skill"
      }
    }
  },
  "enabledPlugins": {
    "logo-design@logo-design-skill": true
  }
}
