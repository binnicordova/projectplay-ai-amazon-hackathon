# Copy to teacher/.env (git ignores it) and rebuild the app: Expo inlines EXPO_PUBLIC_ variables at build time.
# The key ends up inside the APK, so anyone with the APK can use it: keep a spending alert on the account.
EXPO_PUBLIC_AI_PROVIDER=deepseek
EXPO_PUBLIC_DEEPSEEK_API_KEY=
# Optional: the DeepSeek model (the app falls back to deepseek-chat if this name is unknown).
EXPO_PUBLIC_DEEPSEEK_MODEL=deepseek-flash
