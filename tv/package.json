{
  "name": "@projectplay/tv-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "ProjectPlay TV apps, built on the AmazonAppDev react-native-multi-tv-app-sample (MIT-0): Fire OS / Android TV / tvOS / web via Expo, and Vega OS via the Vega SDK.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "yarn@4.5.0",
  "resolutions": {
    "js-yaml": "^3.15.1",
    "min-document": "^2.19.1",
    "logkitty": "^0.7.1",
    "node-fetch": "^2.6.7",
    "ws": "^8.21.0"
  },
  "scripts": {
    "start": "yarn workspace @projectplay/expo-tv start",
    "android": "yarn workspace @projectplay/expo-tv android",
    "android:release": "yarn workspace @projectplay/expo-tv android:release",
    "ios": "yarn workspace @projectplay/expo-tv ios",
    "web": "yarn workspace @projectplay/expo-tv web",
    "vega": "yarn workspace @projectplay/vega start",
    "build:vega": "yarn workspace @projectplay/vega build",
    "build:vega:debug": "yarn workspace @projectplay/vega build:debug",
    "test": "vitest run",
    "typecheck": "yarn workspace @projectplay/expo-tv typecheck",
    "check": "yarn typecheck && yarn test"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
