{
  "expo": {
    "name": "Mimikai",
    "slug": "mimikai-tv",
    "version": "1.0.0",
    "scheme": "mimikai-tv",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1026",
    "newArchEnabled": false,
    "android": {
      "package": "com.mimikai.tv",
      "adaptiveIcon": {
        "backgroundColor": "#0B1026",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "ios": {
      "bundleIdentifier": "com.mimikai.tv"
    },
    "plugins": [
      "expo-router",
      "./plugins/withKotlinJvmTarget",
      "./plugins/withKeyEvent",
      "./plugins/withTvosDeploymentTarget",
      [
        "@react-native-tvos/config-tv",
        {
          "androidTVBanner": "./assets/tv_icons/icon-400x240.png",
          "appleTVImages": {
            "icon": "./assets/tv_icons/icon-1280x768.png",
            "iconSmall": "./assets/tv_icons/icon-400x240.png",
            "iconSmall2x": "./assets/tv_icons/icon-800x480.png",
            "topShelf": "./assets/tv_icons/icon-1920x720.png",
            "topShelf2x": "./assets/tv_icons/icon-1920x720.png",
            "topShelfWide": "./assets/tv_icons/icon-1920x720.png",
            "topShelfWide2x": "./assets/tv_icons/icon-1920x720.png"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "kotlinVersion": "2.1.20",
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withFmtXcode26Fix"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e8441193-8a47-4cf8-92f1-a7161c5535f5"
      }
    },
    "owner": "llaapp",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e8441193-8a47-4cf8-92f1-a7161c5535f5",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
