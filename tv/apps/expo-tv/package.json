{
  "name": "@mimikai/expo-tv",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "EXPO_TV=1 expo start",
    "android": "EXPO_TV=1 expo run:android",
    "android:release": "EXPO_TV=1 expo run:android --variant release",
    "ios": "EXPO_TV=1 expo run:ios",
    "web": "expo start --web --port 8082",
    "prebuild": "EXPO_TV=1 expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@mimikai/contracts": "portal:../../../shared/contracts",
    "@mimikai/tv-shared": "workspace:*",
    "expo": "~54.0.0",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-network": "~8.0.8",
    "expo-router": "~6.0.24",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.16",
    "jotai": "2.20.3",
    "mitt": "^3.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "npm:react-native-tvos@~0.81.0-0",
    "react-native-keyevent": "^0.3.2",
    "react-native-pixel-perfect": "^1.0.2",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "^4.24.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-tv-space-navigation": "6.0.0-beta1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@react-native-tvos/config-tv": "^0.1.7",
    "@types/react": "~19.1.0",
    "typescript": "~5.7.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    }
  }
}
