{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["contracts/src", "exercise-engine/src", "pet/src", "pet/rig.ts"],
  // The rig is React Native: each app typechecks it with its own React Native version.
  "exclude": ["pet/src/rig", "pet/rig.ts"]
}
